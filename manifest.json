{
  "manifest_version": 3,
  "name": "Multilogin Autofill",
  "version": "1.0",
  "description": "Recebe id/senha do Painel Multilogin e preenche o login na aba de destino.",
  "permissions": ["scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://wca091.github.io/casas/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
